@model DeleteLifeAreaViewModel

@{
    ViewData["Title"] = "Delete Life Area";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <h1 class="display-6 mb-1">Delete Life Area</h1>
            <p class="text-muted mb-4">This action cannot be undone.</p>

            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <h2 class="h5">@Model.Name</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-3">@Model.Description</p>
                    }
                    <p class="mb-0">Are you sure you want to permanently delete this life area?</p>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">Delete life area</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
