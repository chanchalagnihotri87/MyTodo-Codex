@model HomeIndexViewModel

@{
    ViewData["Title"] = "Life Areas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 mb-1">Life Areas</h1>
            <p class="text-muted mb-0">The areas of life you want to manage.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge text-bg-secondary">@Model.LifeAreas.Count</span>
            <a asp-controller="LifeAreas" asp-action="Create" class="btn btn-primary">Create life area</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (Model.LifeAreas.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No life areas have been created yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var lifeArea in Model.LifeAreas)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <h2 class="h5 card-title mb-2">@lifeArea.Name</h2>
                                <span class="badge @(lifeArea.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(lifeArea.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lifeArea.Description))
                            {
                                <p class="card-text text-muted mb-0">@lifeArea.Description</p>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-top-0 pt-0">
                            <a asp-controller="LifeAreas" asp-action="Edit" asp-route-id="@lifeArea.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a asp-controller="LifeAreas" asp-action="Delete" asp-route-id="@lifeArea.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
