@model HomeIndexViewModel

@{
    ViewData["Title"] = "Life Areas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 mb-1">Life Areas</h1>
            <p class="text-muted mb-0">The areas of life you want to manage.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="LifeAreas" asp-action="Create" class="btn btn-primary">Create life area</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (Model.LifeAreas.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No life areas have been created yet.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var lifeArea in Model.LifeAreas)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h2 class="h5 card-title mb-0">@lifeArea.Name</h2>
                                <div class="dropdown">
                                    <button class="btn btn-sm text-body p-0 ms-2" type="button" id="dropdownMenu@(lifeArea.Id)" data-bs-toggle="dropdown" aria-expanded="false" title="More options">⋮</button>
                                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenu@(lifeArea.Id)">
                                        <li><a class="dropdown-item" asp-controller="LifeAreas" asp-action="Edit" asp-route-id="@lifeArea.Id">Edit</a></li>
                                        <li><a class="dropdown-item text-danger" asp-controller="LifeAreas" asp-action="Delete" asp-route-id="@lifeArea.Id">Delete</a></li>
                                    </ul>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(lifeArea.Description))
                            {
                                <p class="card-text text-muted mb-0">@lifeArea.Description</p>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
